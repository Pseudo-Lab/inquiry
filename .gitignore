# macOS
.DS_Store

# 프로젝트 로컬 API 키
.env
.env.*
!.env.example

# Claude Code (로컬 설정은 무시, 공유 스킬은 추적)
.claude/*
!.claude/skills/

# Python 프로토타입 / 가상환경
__pycache__/
*.pyc
prototypes/**/out/
.venv/

# 로컬 런타임 데이터 / 에이전트 툴링 (소스 아님)
.inquiry/
.omx/
.superpowers/

# handoff 문서 (git에 올리지 않음 — 로컬/에이전트 인계용)
docs/handoff/

# 진행/실험 과정 문서 — git에는 확정 기능·결정(ADR)·검증된 reference만 둔다.
# reports는 로컬 보존(작업 기록)하되 추적하지 않는다.
docs/reports/

# 테스트 코드 — 사용자 결정으로 git 비추적(로컬 보존). 주의: CI/협업자는 미실행.
tests/
